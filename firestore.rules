rules_version = '2';

// Regras do Firestore do site da Taurus Racing.
// Os formulários só podem CRIAR documentos, com os campos esperados e tamanhos
// limitados. Ninguém lê, altera ou apaga pelo site: a equipe vê as respostas no
// console do Firebase (Firestore Database → inscricoes / mensagens).
service cloud.firestore {
  match /databases/{database}/documents {

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function opcional(d, campo, max) {
      return !(campo in d) || texto(d[campo], 0, max);
    }
    function emailValido(v) {
      return texto(v, 5, 160) && v.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$');
    }
    // carimbo de hora do servidor e endereço da página que enviou
    function carimbo(d) {
      return d.criadoEm == request.time && texto(d.origem, 1, 200);
    }

    // "Faça parte": lista de interesse do processo seletivo
    match /inscricoes/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'email', 'curso', 'periodo', 'area', 'mensagem', 'criadoEm', 'origem'])
        && request.resource.data.keys().hasAll(['nome', 'email', 'curso', 'criadoEm', 'origem'])
        && texto(request.resource.data.nome, 2, 120)
        && emailValido(request.resource.data.email)
        && texto(request.resource.data.curso, 1, 80)
        && opcional(request.resource.data, 'periodo', 10)
        && opcional(request.resource.data, 'area', 80)
        && opcional(request.resource.data, 'mensagem', 3000)
        && carimbo(request.resource.data);
      allow read, update, delete: if false;
    }

    // "Fale com a Taurus": mensagens de contato (patrocínio, imprensa, dúvidas)
    match /mensagens/{id} {
      allow create: if request.resource.data.keys().hasOnly(['nome', 'email', 'assunto', 'empresa', 'mensagem', 'criadoEm', 'origem'])
        && request.resource.data.keys().hasAll(['nome', 'email', 'assunto', 'mensagem', 'criadoEm', 'origem'])
        && texto(request.resource.data.nome, 2, 120)
        && emailValido(request.resource.data.email)
        && texto(request.resource.data.assunto, 1, 60)
        && opcional(request.resource.data, 'empresa', 120)
        && texto(request.resource.data.mensagem, 5, 4000)
        && carimbo(request.resource.data);
      allow read, update, delete: if false;
    }

    // todo o resto fica fechado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
